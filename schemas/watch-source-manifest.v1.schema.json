{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Aqaaab/Cinema/main/schemas/watch-source-manifest.v1.schema.json",
  "title": "Cinema Watch Source Manifest",
  "description": "Versioned declaration of a title's authorized watch destination, rights evidence, territory, and accessibility metadata. A valid manifest is data, not automatic approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "status", "title", "provider", "rights", "destinations"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string", "minLength": 8, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]+$" },
    "status": { "enum": ["draft", "pending_review", "approved", "suspended", "revoked"] },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_id", "type", "name"],
      "properties": {
        "canonical_id": { "type": "string", "minLength": 1, "maxLength": 180 },
        "type": { "enum": ["movie", "series", "episode", "animation", "short"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "release_year": { "type": "integer", "minimum": 1888, "maximum": 2200 },
        "external_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "value"],
            "properties": {
              "namespace": { "type": "string", "minLength": 1, "maxLength": 40 },
              "value": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          },
          "maxItems": 20
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "name", "homepage", "allowed_hosts"],
      "properties": {
        "provider_id": { "type": "string", "minLength": 2, "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
        "allowed_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 253 }
        },
        "terms_url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["licensor", "evidence_url", "license_reference", "valid_from", "valid_until", "territories", "permitted_methods"],
      "properties": {
        "licensor": { "type": "string", "minLength": 1, "maxLength": 200 },
        "evidence_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "license_reference": { "type": "string", "minLength": 3, "maxLength": 200 },
        "valid_from": { "type": "string", "format": "date-time" },
        "valid_until": { "type": "string", "format": "date-time" },
        "territories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
        },
        "permitted_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["official_embed", "direct_playback", "download", "cache"] }
        },
        "attribution": { "type": "string", "maxLength": 1000 },
        "downloads_allowed": { "type": "boolean", "default": false },
        "caching_allowed": { "type": "boolean", "default": false }
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "url"],
        "properties": {
          "method": { "enum": ["official_embed", "direct_playback", "download", "cache"] },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "label": { "type": "string", "maxLength": 100 }
        }
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audio": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" } },
        "subtitles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" } }
      }
    },
    "accessibility": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["captions", "audio_description", "transcript", "sign_language"] }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewed_at": { "type": "string", "format": "date-time" },
        "reviewer_id": { "type": "string", "maxLength": 120 },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "key_id", "value"],
          "properties": {
            "algorithm": { "const": "Ed25519" },
            "key_id": { "type": "string", "minLength": 1, "maxLength": 120 },
            "value": { "type": "string", "contentEncoding": "base64" }
          }
        }
      }
    }
  }
}